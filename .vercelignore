# Vercel uses this instead of .gitignore when present, so it must cover
# everything .gitignore does.
#
# Note what is deliberately NOT here: public/fonts/denim-trial/. Those files
# are gitignored but do ship, because deploys run from the one machine holding
# the Displaay trial. That keeps them out of the repo and out of teammates'
# checkouts while still letting the deployed site render Denim.
node_modules/
dist/
.env
.env*
.vercel/
.vercel
